<Project>
  <!-- Enable Central Package Management for all src projects -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft Agents AI Framework -->
    <PackageVersion Include="AWS.Bedrock.MEAI" Version="1.1.2" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Harness" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Anthropic" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="1.26.0-preview.261023.1" />
    <!-- Azure -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <!-- Third-party AI SDKs -->
    <PackageVersion Include="Google.GenAI" Version="1.27.0" />
    <PackageVersion Include="Anthropic" Version="12.60.0" />
    <PackageVersion Include="Mistral.SDK" Version="2.3.1" />
    <PackageVersion Include="ModelContextProtocol" Version="2.3.0" />
    <PackageVersion Include="AWSSDK.BedrockRuntime" Version="4.0.101.13" />
    <PackageVersion Include="AWSSDK.Bedrock" Version="4.0.104.1" />
    <PackageVersion Include="AWSSDK.Extensions.Bedrock.MEAI" Version="4.0.101.8" />
    <!-- Code analysis -->
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <!-- SourceLink for symbol packages -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
  </ItemGroup>
</Project>
